/**
 * Normalize a list of addresses (array|string) into:
 *  - array of "Name <email>" strings (preserved names when present)
 *  - and a pure array of validated emails
 */
if ( ! function_exists('emailit_normalize_addresses') ) {
    function emailit_normalize_addresses($value) {
        $list = is_array($value) ? $value : array_map('trim', explode(',', (string) $value));
        $pretty = [];
        $emails = [];

        foreach ($list as $item) {
            if ($item === '') continue;

            // Accept “Name <email>” or plain email
            $name  = '';
            $email = '';

            // Extract email within angle brackets if present
            if (preg_match('/<([^>]+)>/', $item, $m)) {
                $email = trim($m[1]);
                $name  = trim(preg_replace('/<[^>]+>/', '', $item));
                $name  = trim(trim($name), '"\'');
            } else {
                $email = trim($item);
            }

            if (!is_email($email)) continue;

            $emails[] = $email;
            $pretty[] = $name && $name !== $email ? sprintf('%s <%s>', $name, $email) : $email;
        }

        return [$pretty, $emails];
    }
}

/**
 * Build the EmailIt payload from wp_mail() args
 */
if ( ! function_exists('emailit_build_payload') ) {
    function emailit_build_payload(array $atts) {
        // Defaults like core
        $defaults = [
            'to'          => [],
            'subject'     => '',
            'message'     => '',
            'headers'     => [],
            'attachments' => [],
        ];
        $atts = wp_parse_args($atts, $defaults);

        // Parse headers
        $parsed = [
            'content_type' => 'text/plain; charset=UTF-8',
            'reply_to'     => [],
            'cc'           => [],
            'bcc'          => [],
        ];
        if (!empty($atts['headers'])) {
            $lines = is_array($atts['headers']) ? $atts['headers'] : preg_split("/\r\n|\n|\r/", (string) $atts['headers']);
            foreach ($lines as $hline) {
                if (!is_string($hline) || strpos($hline, ':') === false) continue;
                list($name, $value) = array_map('trim', explode(':', $hline, 2));
                $lc = strtolower($name);
                if ($lc === 'content-type') $parsed['content_type'] = $value;
                if ($lc === 'reply-to')     $parsed['reply_to']     = array_map('trim', explode(',', $value));
                if ($lc === 'cc')           $parsed['cc']           = array_map('trim', explode(',', $value));
                if ($lc === 'bcc')          $parsed['bcc']          = array_map('trim', explode(',', $value));
            }
        }

        $is_html = stripos($parsed['content_type'], 'text/html') !== false;

        // Recipients
        list($to_pretty,  $to_emails)  = emailit_normalize_addresses($atts['to']);
        list($cc_pretty,  $cc_emails)  = emailit_normalize_addresses($parsed['cc']);
        list($bcc_pretty, $bcc_emails) = emailit_normalize_addresses($parsed['bcc']);

        // Reply-To (EmailIt expects one; wp_mail can have many—use the first)
        list($_rt_pretty, $rt_emails) = emailit_normalize_addresses($parsed['reply_to']);
        $reply_to = !empty($rt_emails) ? $rt_emails[0] : '';

        // Bodies (always provide both)
        $html_body = $is_html ? (string) $atts['message'] : wpautop(esc_html((string) $atts['message']));
        $text_body = $is_html ? wp_strip_all_tags((string) $atts['message']) : (string) $atts['message'];

        // Attachments: support file paths OR arrays like:
        // ['path'=>..., 'name'=>..., 'type'=>...] OR
        // ['content'=>raw_string, 'name'=>..., 'type'=>...]
        $attachments_payload = [];
        foreach ((array) $atts['attachments'] as $a) {
            $filename = '';
            $content_type = 'application/octet-stream';
            $bytes = null;

            if (is_string($a)) {
                // File path
                $path = $a;
                if (file_exists($path) && is_readable($path)) {
                    $filename     = wp_basename($path);
                    $content_type = wp_check_filetype($filename)['type'] ?: $content_type;
                    $bytes        = file_get_contents($path);
                }
            } elseif (is_array($a)) {
                // Array form
                if (!empty($a['path']) && file_exists($a['path'])) {
                    $filename     = !empty($a['name']) ? $a['name'] : wp_basename($a['path']);
                    $content_type = !empty($a['type']) ? $a['type'] : (wp_check_filetype($filename)['type'] ?: $content_type);
                    $bytes        = file_get_contents($a['path']);
                } elseif (!empty($a['content']) && !empty($a['name'])) {
                    $filename     = $a['name'];
                    $content_type = !empty($a['type']) ? $a['type'] : $content_type;
                    $bytes        = is_string($a['content']) ? $a['content'] : (string) $a['content'];
                }

                // If someone supplies inline/cid, just log (EmailIt API doesn’t support CID inline)
                if ( (!empty($a['inline']) || !empty($a['cid'])) && function_exists('emailit_log') ) {
                    emailit_log('Inline/CID not supported by EmailIt API; sending as normal attachment.', [
                        'filename' => $filename ?: 'attachment',
                        'cid'      => isset($a['cid']) ? $a['cid'] : null,
                    ]);
                }
            }

            if ($bytes !== null) {
                $attachments_payload[] = [
                    'filename'     => $filename ?: 'attachment',
                    'content'      => base64_encode($bytes),        // EmailIt expects a string payload
                    'content_type' => $content_type,
                ];
            }
        }

        $payload = [
            // from gets added later
            'to'      => implode(', ', $to_pretty),
            'subject' => (string) $atts['subject'],
            'html'    => $html_body,
            'text'    => $text_body,
        ];

        // CC/BCC via headers object if present
        $headers_for_api = [];
        if (!empty($cc_pretty))  $headers_for_api['cc']  = implode(', ', $cc_pretty);
        if (!empty($bcc_pretty)) $headers_for_api['bcc'] = implode(', ', $bcc_pretty);
        if (!empty($headers_for_api)) $payload['headers'] = $headers_for_api;

        if (!empty($reply_to))              $payload['reply_to']   = $reply_to;
        if (!empty($attachments_payload))   $payload['attachments'] = $attachments_payload;

        return [$payload, $to_emails];


    }
}

/**
 * Short-circuit wp_mail() and send through EmailIt.
 * Return TRUE on success so callers see a successful send.
 */
add_filter('pre_wp_mail', function ($pre, $atts) {
    // Respect manual override/kill-switch
    if (defined('td_email_override') && td_email_override) {
        emailit_log('Override active; letting core send.');
        return null; // allow default WordPress/PHPMailer flow
    }

    $api_key    = defined('EMAILIT_API_KEY')    ? EMAILIT_API_KEY    : EMAILIT_DEFAULT_API_KEY;
    $from_email = defined('EMAILIT_FROM_EMAIL') ? EMAILIT_FROM_EMAIL : EMAILIT_DEFAULT_FROM_EMAIL;
    $from_name  = defined('EMAILIT_FROM_NAME')  ? EMAILIT_FROM_NAME  : EMAILIT_DEFAULT_FROM_NAME;
    $endpoint   = defined('EMAILIT_ENDPOINT')   ? EMAILIT_ENDPOINT   : EMAILIT_DEFAULT_ENDPOINT;

    if (empty($api_key) || $api_key === 'REPLACE_ME') {
        $error = new WP_Error('emailit_missing_api_key', 'EmailIt API key is missing.');
        do_action('wp_mail_failed', $error);
        return false;
    }

    list($payload, $to_emails) = emailit_build_payload((array) $atts);

    // Finalize "from"
    $payload['from'] = sprintf('%s <%s>', (string) $from_name, (string) $from_email);

    // Send via WP HTTP API
    $args = [
        'headers' => [
            'Authorization' => 'Bearer ' . $api_key,
            'Content-Type'  => 'application/json',
        ],
        'body'    => wp_json_encode($payload),
        'timeout' => 30,
    ];

    emailit_log('Sending payload:', $payload);

    $response = wp_safe_remote_post($endpoint, $args);

    if (is_wp_error($response)) {
        $err = new WP_Error('emailit_http_error', 'EmailIt HTTP error: ' . $response->get_error_message(), [
            'payload' => $payload,
        ]);
        do_action('wp_mail_failed', $err);
        emailit_log('HTTP error', $response->get_error_message());
        return false;
    }

    $code = wp_remote_retrieve_response_code($response);
    $body = wp_remote_retrieve_body($response);

    emailit_log('Response code: ' . $code);
    emailit_log('Response body:', $body);

    if ($code === 200 || $code === 202) {
        // surface provider id if present
        $decoded = json_decode($body, true);
        $message_id = is_array($decoded) ? ($decoded['id'] ?? ($decoded['messageId'] ?? null)) : null;

        // Mirror a "success" action for observability
        do_action('wp_mail_succeeded', [
            'to'        => $to_emails,
            'subject'   => (string) ($atts['subject'] ?? ''),
            'api'       => 'emailit',
            'code'      => $code,
            'messageId' => $message_id,
        ]);

        return true; // <- tells wp_mail() it succeeded
    }

    // Construct a helpful error
    $decoded = json_decode($body, true);
    $msg = 'EmailIt send failed.';
    if (is_array($decoded)) {
        if (!empty($decoded['message']))          $msg = $decoded['message'];
        elseif (!empty($decoded['error']))        $msg = is_string($decoded['error']) ? $decoded['error'] : ($decoded['error']['message'] ?? $msg);
        elseif (!empty($decoded['errors'][0]))    $msg = is_string($decoded['errors'][0]) ? $decoded['errors'][0] : ($decoded['errors'][0]['message'] ?? $msg);
    } else {
        $msg .= ' HTTP ' . $code;
    }

    $err = new WP_Error('emailit_send_failed', $msg, [
        'status'  => $code,
        'body'    => $body,
        'payload' => $payload,
    ]);
    do_action('wp_mail_failed', $err);
    emailit_log('Send failed: ' . $msg, ['code' => $code]);

    return false;
}, 10, 2);


