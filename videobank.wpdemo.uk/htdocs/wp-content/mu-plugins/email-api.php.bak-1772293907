// Small helper: conditional debug log (only when WP_DEBUG true)
if ( ! function_exists('emailit_log') ) {
    function emailit_log($msg, $data = null) {
        if (defined('WP_DEBUG') && WP_DEBUG) {
            if ($data !== null) {
