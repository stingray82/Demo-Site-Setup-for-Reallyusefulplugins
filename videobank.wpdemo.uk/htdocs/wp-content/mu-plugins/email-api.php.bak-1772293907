$rup_debug           = false;
$rup_run_immediately = false; // set true only while testing

$unique_hook     = 'rup_mu_remote_updates_api_cron_' . sanitize_title( $rup_plugin_identifier );
$unique_schedule = 'rup_interval_' . sanitize_title( $rup_plugin_identifier );

add_filter( 'cron_schedules', function ( $schedules ) use ( $rup_schedule_interval, $unique_schedule ) {
    $schedules[ $unique_schedule ] = array(
        'interval' => $rup_schedule_interval,
        'display'  => 'Every ' . ( $rup_schedule_interval / 3600 ) . ' Hours',
    );
    return $schedules;
} );

add_action( 'init', function () use ( $unique_hook, $unique_schedule, $rup_debug ) {
    if ( ! wp_next_scheduled( $unique_hook ) ) {
        wp_schedule_event( time() + 60, $unique_schedule, $unique_hook );
        if ( $rup_debug ) {
            error_log( '[RUP API] Scheduled cron hook: ' . $unique_hook . ' schedule=' . $unique_schedule );
        }
    } else {
        if ( $rup_debug ) {
            error_log( '[RUP API] Cron already scheduled: ' . $unique_hook );
        }
    }
} );

add_action( $unique_hook, function () use ( $rup_update_api_url, $rup_api_key, $rup_plugin_identifier, $rup_local_file, $rup_debug ) {
    if ( $rup_debug ) {
        error_log( '[RUP API] Cron fired: ' . current_time( 'mysql' ) . ' plugin=' . $rup_plugin_identifier );
    }
    $updater = new rup_mu_updater_emailit( $rup_update_api_url, $rup_api_key, $rup_local_file, $rup_plugin_identifier, $rup_debug );
    $updater->check_for_update();
} );

if ( $rup_run_immediately ) {
    if ( $rup_debug ) {
        error_log( '[RUP API] Immediate run enabled: ' . current_time( 'mysql' ) );
    }
    $updater = new rup_mu_updater_emailit( $rup_update_api_url, $rup_api_key, $rup_local_file, $rup_plugin_identifier, $rup_debug );
    $updater->check_for_update();
}






