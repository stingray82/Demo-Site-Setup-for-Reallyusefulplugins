if ( ! class_exists( 'rup_mu_updater_emailit' ) ) {

    class rup_mu_updater_emailit {

        private $api_url;
        private $api_key;
        private $local_file;
        private $plugin_id;
        private $debug;
        private $log_prefix = '[RUP API]';

        public function __construct( $api_url, $api_key, $local_file, $plugin_id, $debug = false ) {
            $this->api_url    = $api_url;
            $this->api_key    = $api_key;
            $this->local_file = $local_file;
            $this->plugin_id  = $plugin_id;
            $this->debug      = (bool) $debug;
        }

        private function log( $message ) {
            if ( ! $this->debug ) {
                return;
            }
            error_log( $this->log_prefix . ' ' . $message );
        }

        private function summarize( $text, $max = 500 ) {
            $text = (string) $text;
            $text = preg_replace( "/\s+/", " ", $text );
            if ( strlen( $text ) > $max ) {
                return substr( $text, 0, $max ) . '... [trimmed]';
            }
            return $text;
        }

        /**
         * Keep only the most recent $keep backup files: email-api.php.bak-*
         */
        private function cleanup_backups( $keep = 3 ) {
            $pattern = $this->local_file . '.bak-*';
            $files = glob( $pattern );
            if ( ! $files || count( $files ) <= $keep ) {
                $this->log( 'Backup cleanup: nothing to delete (count=' . (int) count( (array) $files ) . ', keep=' . (int) $keep . ')' );
                return;
            }

            usort( $files, function ( $a, $b ) {
                return @filemtime( $b ) <=> @filemtime( $a );
            } );

            $to_delete = array_slice( $files, $keep );
            foreach ( $to_delete as $f ) {
                if ( @unlink( $f ) ) {
                    $this->log( 'Deleted old backup: ' . $f );
                } else {
                    $this->log( 'WARNING: Failed to delete old backup: ' . $f );
                }
            }
        }

        /**
         * Clean up temp files older than 1 day.
         */
        private function cleanup_tmp_files( $dir, $older_than_seconds = 86400 ) {
            $pattern = $dir . '/.' . basename( $this->local_file ) . '.tmp-*';
            $files = glob( $pattern );
            if ( ! $files ) {
                return;
            }

            $now = time();
            foreach ( $files as $f ) {
                $mtime = @filemtime( $f );
                if ( $mtime && ( $now - $mtime ) > $older_than_seconds ) {
                    if ( @unlink( $f ) ) {
                        $this->log( 'Deleted old tmp: ' . $f );
                    }
                }
            }
        }

        public function check_for_update() {

            $this->log( '--- check_for_update START ---' );
            $this->log( 'plugin_id=' . $this->plugin_id );
            $this->log( 'api_url=' . $this->api_url );
            $this->log( 'local_file=' . $this->local_file );
            $this->log( 'site_url=' . home_url() );

            $dir = dirname( $this->local_file );

            $this->log( 'file_exists=' . ( file_exists( $this->local_file ) ? 'yes' : 'no' ) );
            $this->log( 'is_readable=' . ( is_readable( $this->local_file ) ? 'yes' : 'no' ) );
            $this->log( 'is_writable=' . ( is_writable( $this->local_file ) ? 'yes' : 'no' ) );
            $this->log( 'dir_writable=' . ( is_writable( $dir ) ? 'yes' : 'no' ) );
            $this->log( 'dir=' . $dir );

            if ( ! is_writable( $dir ) ) {
                $this->log( 'ERROR: Directory is not writable, cannot stage update: ' . $dir );
                $this->log( '--- check_for_update END (dir not writable) ---' );
                return;
            }

            // Housekeeping
            $this->cleanup_tmp_files( $dir, 86400 );

            // Read local version
            $local_data    = $this->get_plugin_header_data_from_file( $this->local_file );
            $local_version = ! empty( $local_data['Version'] ) ? trim( $local_data['Version'] ) : '';
            $this->log( 'local_version_parsed=' . ( $local_version !== '' ? $local_version : '(empty)' ) );

            // Build API request
            $args = array(
                'timeout' => 15,
                'headers' => array(
                    'Authorization' => 'Bearer ' . $this->api_key,
                ),
                'body'    => array(
                    'plugin'   => $this->plugin_id,
                    'version'  => $local_version,
                    'site_url' => home_url(),
                    'ip'       => $_SERVER['REMOTE_ADDR'] ?? '',
                ),
            );

            $this->log( 'POST body=' . $this->summarize( wp_json_encode( $args['body'] ) ) );

            $response = wp_remote_post( $this->api_url, $args );
            if ( is_wp_error( $response ) ) {
                $this->log( 'ERROR: wp_remote_post failed: ' . $response->get_error_message() );
                $this->log( '--- check_for_update END (api error) ---' );
                return;
            }

            $api_code = wp_remote_retrieve_response_code( $response );
            $api_body = wp_remote_retrieve_body( $response );

            $this->log( 'API http_code=' . $api_code );
            $this->log( 'API raw_body=' . $this->summarize( $api_body ) );

            if ( (int) $api_code !== 200 ) {
                $this->log( 'ERROR: API did not return 200.' );
                $this->log( '--- check_for_update END (api non-200) ---' );
                return;
            }

            $data = json_decode( $api_body, true );
            if ( json_last_error() !== JSON_ERROR_NONE ) {
                $this->log( 'ERROR: JSON parse failed: ' . json_last_error_msg() );
                $this->log( '--- check_for_update END (json error) ---' );
                return;
            }

            $this->log( 'API decoded=' . $this->summarize( wp_json_encode( $data ) ) );

            if ( empty( $data['update_available'] ) ) {
                $this->log( 'No update available.' );
                $this->log( '--- check_for_update END ---' );
                return;
            }

            if ( empty( $data['download_url'] ) || empty( $data['version'] ) ) {
                $this->log( 'ERROR: update_available true but download_url or version missing.' );
                $this->log( '--- check_for_update END (missing fields) ---' );
                return;
            }

            $download_url   = trim( $data['download_url'] );
            $remote_version = trim( $data['version'] );

            $this->log( 'Update available! remote_version=' . $remote_version );
            $this->log( 'download_url=' . $download_url );

            // Download update file
            $remote_response = wp_remote_get( $download_url, array( 'timeout' => 20 ) );
            if ( is_wp_error( $remote_response ) ) {
                $this->log( 'ERROR: wp_remote_get failed: ' . $remote_response->get_error_message() );
                $this->log( '--- check_for_update END (download error) ---' );
                return;
            }

            $dl_code = wp_remote_retrieve_response_code( $remote_response );
            $dl_body = wp_remote_retrieve_body( $remote_response );

            $this->log( 'Download http_code=' . $dl_code );
            $this->log( 'Download bytes=' . strlen( (string) $dl_body ) );
            $this->log( 'Download first_80=' . $this->summarize( substr( (string) $dl_body, 0, 80 ), 200 ) );

            if ( (int) $dl_code !== 200 ) {
                $this->log( 'ERROR: Download URL did not return 200.' );
                $this->log( '--- check_for_update END (download non-200) ---' );
                return;
            }

            if ( empty( $dl_body ) ) {
                $this->log( 'ERROR: Downloaded file is empty.' );
                $this->log( '--- check_for_update END (empty download) ---' );
                return;
            }

            // Stage to tmp file in same dir
            $tmp_file = $dir . '/.' . basename( $this->local_file ) . '.tmp-' . time() . '-' . wp_generate_password( 6, false, false );
            $bak_file = $this->local_file . '.bak-' . time();

            $this->log( 'Staging to tmp_file=' . $tmp_file );
            $bytes_written = @file_put_contents( $tmp_file, $dl_body );

            if ( $bytes_written === false ) {
                $this->log( 'ERROR: Failed writing tmp file: ' . $tmp_file );
                $this->log( '--- check_for_update END (tmp write failed) ---' );
                return;
            }

            $this->log( 'Tmp write OK. bytes_written=' . $bytes_written );

            clearstatcache( true, $tmp_file );
            if ( ! file_exists( $tmp_file ) || filesize( $tmp_file ) <= 0 ) {
                $this->log( 'ERROR: Tmp file missing/empty after write. Aborting.' );
                @unlink( $tmp_file );
                $this->log( '--- check_for_update END (tmp verify failed) ---' );
                return;
            }

            // Rotate current to backup (if exists)
            if ( file_exists( $this->local_file ) ) {
                $this->log( 'Renaming current file to backup: ' . $bak_file );
                if ( ! @rename( $this->local_file, $bak_file ) ) {
                    $this->log( 'ERROR: Failed to rename current file to backup.' );
                    @unlink( $tmp_file );
                    $this->log( '--- check_for_update END (backup rename failed) ---' );
                    return;
                }
            } else {
                $this->log( 'Current file did not exist; installing fresh.' );
            }

            // Promote tmp to live
            $this->log( 'Promoting tmp to live: ' . $tmp_file . ' -> ' . $this->local_file );

            if ( ! @rename( $tmp_file, $this->local_file ) ) {
                $this->log( 'ERROR: Failed to rename tmp to live. Attempting rollback.' );

                if ( file_exists( $bak_file ) ) {
                    @rename( $bak_file, $this->local_file );
                    $this->log( 'Rollback attempted: restored backup to live.' );
                }

                @unlink( $tmp_file );
                $this->log( '--- check_for_update END (promote failed) ---' );
                return;
            }

            // Confirm version
            $new_local_data    = $this->get_plugin_header_data_from_file( $this->local_file );
            $new_local_version = ! empty( $new_local_data['Version'] ) ? trim( $new_local_data['Version'] ) : '';
            $this->log( 'After promote: local_version_parsed=' . ( $new_local_version !== '' ? $new_local_version : '(empty)' ) );

            $this->log( 'Updated plugin from ' . ( $local_version ?: '(empty)' ) . ' to remote ' . $remote_version );
            $this->log( 'Backup kept at: ' . ( file_exists( $bak_file ) ? $bak_file : '(no backup)' ) );

            // Keep only 3 most recent backups
            $this->cleanup_backups( 3 );

            $this->log( '--- check_for_update END (success) ---' );
        }

        private function get_plugin_header_data_from_file( $file ) {
            if ( ! file_exists( $file ) ) {
                return array();
            }
            $plugin_data = file_get_contents( $file );
            return $this->get_plugin_header_data_from_string( $plugin_data );
        }

        private function get_plugin_header_data_from_string( $plugin_data ) {
            $default_headers = array(
                'Name'        => 'Plugin Name',
                'Version'     => 'Version',
                'PluginURI'   => 'Plugin URI',
                'Description' => 'Description',
                'Author'      => 'Author',
                'AuthorURI'   => 'Author URI',
                'TextDomain'  => 'Text Domain',
            );

            $data = array();
            foreach ( $default_headers as $field => $header ) {
                if (
                    preg_match(
                        '/^[ \t\/*#@]*' . preg_quote( $header, '/' ) . '\s*:\s*(.*)$/mi',
                        $plugin_data,
                        $match
                    )
                    && ! empty( $match[1] )
                ) {
                    $data[ $field ] = trim( $match[1] );
                } else {
                    $data[ $field ] = '';
                }
            }
            return $data;
        }
    }
